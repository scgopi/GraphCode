{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Externally supplied UI claim authority snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "issueNumber", "sourceUrl", "sourceCommentId", "sourceUpdatedAt", "sourceBodySha256", "claims"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "repository": { "type": "string", "const": "scgopi/GraphCode" },
    "issueNumber": { "type": "integer", "minimum": 1 },
    "sourceUrl": { "type": "string", "pattern": "^https://github\\.com/scgopi/GraphCode/issues/[1-9][0-9]*#issuecomment-[1-9][0-9]*(?![\\s\\S])" },
    "sourceCommentId": { "type": "integer", "minimum": 1 },
    "sourceUpdatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z(?![\\s\\S])" },
    "sourceBodySha256": { "$ref": "#/definitions/hash" },
    "claims": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "criterion", "criterionSha256", "proofClass", "states"],
        "properties": {
          "id": { "type": "string", "pattern": "^[1-9][0-9]*-C[1-9][0-9]*(?![\\s\\S])" },
          "criterion": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "\\S" },
          "criterionSha256": { "$ref": "#/definitions/hash" },
          "proofClass": { "enum": ["semantic-uia", "visual", "input", "mixed"] },
          "states": {
            "type": "object", "additionalProperties": false,
            "required": ["success", "empty", "error", "disabled", "persistence-after-relaunch", "keyboard"],
            "properties": {
              "success": { "$ref": "#/definitions/applicability" },
              "empty": { "$ref": "#/definitions/applicability" },
              "error": { "$ref": "#/definitions/applicability" },
              "disabled": { "$ref": "#/definitions/applicability" },
              "persistence-after-relaunch": { "$ref": "#/definitions/applicability" },
              "keyboard": { "$ref": "#/definitions/applicability" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "reason"],
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S" }
      }
    }
  }
}
