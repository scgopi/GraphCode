{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Packaged UI scenario fixture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureId", "fixtureVersion", "files"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "fixtureId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}(?![\\s\\S])" },
    "fixtureVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "maxLength": 240 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" }
        }
      }
    }
  }
}
