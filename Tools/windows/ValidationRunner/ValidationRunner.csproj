<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Bindings\**\*.cs" />
    <AssemblyMetadata Include="GraphCode.Validation.SourceRoot" Value="$(MSBuildProjectDirectory)" />
    <Compile Include="..\UiaWindowActivation.cs" Link="Production\UiaWindowActivation.cs" />
    <ProjectReference Include="Bindings\ValidationFixtureBindings.csproj" />
    <None Update="Manifests\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
