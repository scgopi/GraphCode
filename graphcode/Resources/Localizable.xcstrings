    "Remove %@ from GraphCode — its saved loops survive for whenever you re-add it — or also delete its loops and move the folder to the Trash, where it stays recoverable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aus GraphCode entfernen — die gespeicherten Loops bleiben erhalten, falls du den Ordner wieder hinzufügst — oder zusätzlich seine Loops löschen und den Ordner in den Papierkorb legen, wo er wiederherstellbar bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita %@ de GraphCode —sus bucles guardados se conservan para cuando la vuelvas a añadir— o elimina también sus bucles y mueve la carpeta a la papelera, donde seguirá siendo recuperable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer %@ de GraphCode — ses boucles enregistrées sont conservées pour le jour où vous le rajouterez — ou supprimer aussi ses boucles et placer le dossier dans la corbeille, où il reste récupérable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi %@ da GraphCode — i loop salvati restano disponibili per quando la aggiungerai di nuovo — oppure elimina anche i suoi loop e sposta la cartella nel Cestino, da cui resta recuperabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を GraphCode から取り除きます。保存されたループは残るので、再度追加したときにそのまま使えます。ループも削除してフォルダをゴミ箱に入れることもできます（ゴミ箱からは復元できます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GraphCode에서 %@을(를) 제거합니다 — 저장된 루프는 다시 추가할 때를 위해 그대로 남습니다 — 또는 루프까지 삭제하고 폴더를 휴지통으로 옮길 수 있으며, 휴지통에서는 복구할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova %@ do GraphCode — os loops salvos continuam guardados para quando você adicioná-la de novo — ou exclua também os loops dela e mova a pasta para o Lixo, de onde ainda é possível recuperá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уберите %@ из GraphCode — сохранённые циклы останутся на случай, если вы добавите папку снова, — либо удалите её циклы и переместите папку в Корзину, откуда её можно восстановить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 GraphCode 中移除 %@ — 已保存的循环会保留，以便你日后重新添加 — 或者同时删除它的循环并将文件夹移到废纸篓，在那里仍可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 GraphCode 移除 %@ — 已儲存的迴圈會保留，供你日後重新加入時使用 — 或是連同迴圈一併刪除，並將檔案夾移到垃圾桶，之後仍可還原。"
          }
        }
      }
    },
