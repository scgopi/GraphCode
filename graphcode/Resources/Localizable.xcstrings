    "%@'s nodes and edges will be permanently deleted. The folder itself is not touched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Knoten und Kanten von %@ werden dauerhaft gelöscht. Der Ordner selbst bleibt unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nodos y las aristas de %@ se eliminarán de forma permanente. La carpeta en sí no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nœuds et les liens de %@ seront définitivement supprimés. Le dossier lui-même n'est pas touché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nodi e gli archi di %@ verranno eliminati definitivamente. La cartella non viene toccata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のノードとエッジは完全に削除されます。フォルダ自体はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 노드와 엣지가 영구적으로 삭제됩니다. 폴더 자체는 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nós e as arestas de %@ serão excluídos permanentemente. A pasta em si não é alterada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узлы и связи «%@» будут удалены безвозвратно. Сама папка не затрагивается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的节点和连线将被永久删除。文件夹本身不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的節點與連線將被永久刪除。檔案夾本身不會受到影響。"
          }
        }
      }
    },
