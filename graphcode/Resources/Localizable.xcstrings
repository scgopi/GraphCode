    "Changes apply as you make them — Done just closes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen greifen sofort — „Fertig“ schließt nur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se aplican al instante; «Listo» solo cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications s'appliquent au fur et à mesure — Terminé ne fait que fermer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche vengono applicate subito — Fine chiude e basta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は加えるたびに適用されます —「完了」は閉じるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 즉시 적용됩니다 — 완료는 닫기만 합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são aplicadas conforme você as faz — Concluir apenas fecha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения применяются сразу — «Готово» просто закрывает окно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改会即时生效 —「完成」只是关闭窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更動會立即生效 —「完成」只是關閉。"
          }
        }
      }
    },
