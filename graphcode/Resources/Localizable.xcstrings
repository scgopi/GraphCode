    "The default for new loops. Change it any time in Settings, or per loop.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standard für neue Loops. Jederzeit in den Einstellungen oder pro Loop änderbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El valor predeterminado para los bucles nuevos. Cámbialo cuando quieras en Ajustes, o bucle por bucle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur par défaut des nouvelles boucles. Modifiable à tout moment dans les Réglages, ou boucle par boucle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il valore predefinito per i nuovi loop. Puoi cambiarlo quando vuoi in Impostazioni, o per singolo loop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規ループのデフォルトです。設定でいつでも変更でき、ループごとの指定もできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 루프의 기본값입니다. 설정에서 언제든지, 또는 루프별로 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão para novos loops. Mude quando quiser nos Ajustes, ou por loop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение по умолчанию для новых циклов. Его можно изменить в настройках в любой момент или для отдельного цикла."
          }
        },
