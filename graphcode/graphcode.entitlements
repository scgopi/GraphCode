<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Deliberately NOT sandboxed. The whole point of the app is to spawn arbitrary
	     CLI backends (claude, codex, …) against arbitrary directories a human picks;
	     App Sandbox would need a user-selected-file bookmark per worktree and would
	     still block the PTY children from reaching their own config and credentials.
	     Notarization does not require the sandbox — only the hardened runtime, which
	     `make release-dmg` turns on with `codesign --options runtime`. -->

	<!-- The mirror of ThirdParty/ghostty/macos/Ghostty.entitlements (its release set).
	     TCC attributes anything a PTY child asks for to the app that spawned it, so a
	     session running `claude` that wants the microphone or the address book is
	     denied outright unless GraphCode itself carries the entitlement. Ghostty ships
	     exactly these for exactly that reason; a terminal that hosts other people's
	     programs cannot enumerate in advance what they will ask for. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
</dict>
</plist>
